# 数据库连接（默认指向 Docker Compose 启动的 MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=123456
DB_NAME=testworkbench

# 前端跨域来源（Vite 开发服务器默认 5173）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 调试模式
DEBUG=true

# 本机单用户模式：仅接受 localhost/127.0.0.1，登录会话自动续期
LOCAL_ONLY=true
SESSION_DAYS=90

# 留空时首次启动自动生成 backend/.app_secret；云端部署应显式设置
APP_SECRET_KEY=
